{
  "version": "1.0",
  "updated": "2026-05-27",
  "routes": {
    "query": {
      "quick": "wiki/index.md",
      "full": "wiki/concepts/"
    },
    "ingest": {
      "source": "_raw/",
      "archive": "raw/",
      "output": "wiki/",
      "manifest": ".manifest.json"
    },
    "context": {
      "L0": "ai/L0_profile.md",
      "L1": ["wiki/purpose.md", "ai/L1_architecture.md", "wiki/index.md"],
      "L2": "ai/L2_detail/",
      "L3": "wiki/concepts/"
    },
    "reports": {
      "daily": "wiki/reports/daily/",
      "weekly": "wiki/reports/weekly/"
    },
    "export": {
      "output": "wiki/graphs/",
      "formats": ["graph.json", "graph.graphml", "graph.cypher", "graph.html"]
    },
    "claude-history": {
      "source": "~/.claude/history.jsonl",
      "sessions": "~/.claude/projects/",
      "output": "wiki/concepts/",
      "maxSessions": 50
    },
    "cross-linker": {
      "source": "wiki/concepts/",
      "scan": ["wiki/concepts/", "wiki/topics/", "wiki/comparisons/", "wiki/patterns/", "wiki/"],
      "exclude": ["_raw/", "raw/", "wiki/graphs/", "wiki/reports/", "wiki/log.md"],
      "maxReplacementsPerRun": 200,
      "maxReplacementsPerFile": 30,
      "maxPerTermPerFile": 3
    },
    "human": {
      "source": "wiki/",
      "output": {
        "handbook": "human/PROJECT_WIKI.md",
        "business_qa": "human/BUSINESS_QA.md"
      },
      "noEditMarker": "<!-- no-edit -->",
      "truthSource": "wiki/"
    }
  }
}
